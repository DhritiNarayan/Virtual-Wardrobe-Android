<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF0F5"
    android:padding="20dp">
    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:text="← Back"
        android:textAllCaps="false"
        android:textColor="#92566B"
        android:backgroundTint="#F8D7E3"
        android:textSize="14sp" />
    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OUTFIT STUDIO ✨"
        android:textColor="#92566B"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Create your look."
        android:textColor="#92566B"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Mix and match your wardrobe 💗"
        android:textColor="#AA8492"
        android:textSize="14sp" />

    <!-- Preview heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Your Outfit Preview"
        android:textColor="#92566B"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Outfit preview -->
    <GridLayout
        android:id="@+id/gridOutfitPreview"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="10dp"
        android:columnCount="2"
        android:background="#FFFFFAFC"
        android:padding="6dp" />

    <!-- Selection heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Select clothes to combine"
        android:textColor="#92566B"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Scrollable clothing selection -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls">

        <GridLayout
            android:id="@+id/gridSelectableClothes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2" />

    </ScrollView>

    <Button
        android:id="@+id/btnSaveOutfit"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#92566B"
        android:text="Save Outfit 💗"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- Clear Button -->
    <Button
        android:id="@+id/btnClearOutfit"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#E89AAE"
        android:text="Clear Outfit"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>